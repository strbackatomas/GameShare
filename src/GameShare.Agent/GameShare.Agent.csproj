<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The web SDK turns on the server GC by default. This service shares a gaming PC with the game, so keep memory and threads low. -->
    <ServerGarbageCollector>false</ServerGarbageCollector>
      <!-- Published output only needs Czech and English resources and no debug symbols. -->
    <SatelliteResourceLanguages>cs;en</SatelliteResourceLanguages>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameShare.Core\GameShare.Core.csproj" />
    <ProjectReference Include="..\GameShare.Protocol\GameShare.Protocol.csproj" />
    <ProjectReference Include="..\GameShare.Discovery\GameShare.Discovery.csproj" />
    <ProjectReference Include="..\GameShare.Storage\GameShare.Storage.csproj" />
    <ProjectReference Include="..\GameShare.Torrent\GameShare.Torrent.csproj" />
  </ItemGroup>

</Project>
