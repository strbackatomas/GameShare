<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameShare.Client.ViewModels"
             x:Class="GameShare.Client.Views.LogView"
             x:DataType="vm:LogViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.log-segment">
            <Setter Property="FontFamily" Value="Consolas,Cascadia Mono,Courier New,monospace" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <!-- A number, id, address or path inside an otherwise plain line: made to stand out from the sentence around it. -->
        <Style Selector="TextBlock.log-segment.log-value">
            <Setter Property="Foreground" Value="{StaticResource LogValueBrush}" />
        </Style>
        <!-- The leading timestamp: repeated on every line, so dimmed rather than fought for attention. -->
        <Style Selector="TextBlock.log-segment.log-timestamp">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <!-- A line already coloured whole by its level (its one segment carries neither class above). -->
        <Style Selector="ItemsControl.log-error TextBlock.log-segment">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        </Style>
        <Style Selector="ItemsControl.log-warn TextBlock.log-segment">
            <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
        </Style>
        <Style Selector="ItemsControl.log-debug TextBlock.log-segment">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="24,8,24,24">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto">
            <TextBlock Grid.Column="0" Classes="section" Text="PROTOKOL AGENTA" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Vymazat" Command="{Binding ClearCommand}" IsEnabled="{Binding !IsEmpty}" Margin="0,0,8,0" />
            <Button Grid.Column="2" Content="Kopírovat" Command="{Binding CopyCommand}" IsEnabled="{Binding !IsEmpty}" Margin="0,0,8,0" />
            <Button Grid.Column="3" Content="Obnovit" Command="{Binding LoadCommand}" IsEnabled="{Binding !IsLoading}" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
            <StackPanel Grid.Column="0">
                <ToggleSwitch IsChecked="{Binding TorrentDebugLogging}"
                              OnContent="Podrobné ladicí logy z torrentu zapnuté" OffContent="Podrobné ladicí logy z torrentu vypnuté" />
                <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,2,0,0"
                           Text="Storage/PerformanceWarning/SessionLog/TorrentLog/PeerLog z libtorrentu. Projeví se až po restartu agenta." />
            </StackPanel>
            <Button Grid.Column="1" Classes="danger" Content="Restartovat agenta" Command="{Binding RestartPromptCommand}"
                    IsVisible="{Binding ShowRestartButton}" VerticalAlignment="Top" />
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,8,0,0" IsVisible="{Binding IsConfirmingRestart}">
            <TextBlock Grid.Column="0" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center"
                       Text="Opravdu restartovat agenta? Krátce se přeruší spojení a všechny právě běžící přenosy se na chvíli zastaví." />
            <Button Grid.Column="1" Classes="danger" Content="Ano, restartovat" Command="{Binding ConfirmRestartCommand}" Margin="8,0,0,0" />
            <Button Grid.Column="2" Content="Zrušit" Command="{Binding CancelRestartCommand}" Margin="8,0,0,0" />
        </Grid>

        <TextBlock Grid.Row="3" Text="{Binding Message}" IsVisible="{Binding HasMessage}" Margin="0,6,0,0" TextWrapping="Wrap" />

        <Border Grid.Row="4" Classes="card" Margin="0,10,0,0" Padding="10">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Zatím žádný záznam." Classes="muted" IsVisible="{Binding IsEmpty}" />
                    <ItemsControl ItemsSource="{Binding Lines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LogLineViewModel">
                                <ItemsControl ItemsSource="{Binding Segments}"
                                              Classes.log-error="{Binding IsError}" Classes.log-warn="{Binding IsWarn}" Classes.log-debug="{Binding IsDebug}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:LogSegment">
                                            <TextBlock Classes="log-segment" Classes.log-value="{Binding IsValue}" Classes.log-timestamp="{Binding IsTimestamp}"
                                                       Text="{Binding Text}" TextWrapping="NoWrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
