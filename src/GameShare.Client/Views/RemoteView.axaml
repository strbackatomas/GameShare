<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameShare.Client.ViewModels"
             x:Class="GameShare.Client.Views.RemoteView"
             x:DataType="vm:RemoteViewModel">

    <ScrollViewer>
        <StackPanel Margin="24,8,24,24" MaxWidth="760" HorizontalAlignment="Left" Spacing="6">

            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,8,0,0"
                       IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <!-- ==== Other PCs this one manages ==== -->
            <TextBlock Classes="section" Text="PC, KTERÁ SPRAVUJEŠ ODSUD" />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="Na spárovaném PC můžeš odsud instalovat, aktualizovat a opravovat hry a řídit přenosy. Hrát, mazat hry a měnit nastavení jde jen přímo u něj." />

            <ItemsControl ItemsSource="{Binding Targets}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TargetRow">
                        <Border Classes="card" Padding="12,8">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                <Ellipse Grid.Column="0" Width="10" Height="10" Fill="{StaticResource SuccessBrush}" IsVisible="{Binding Online}"
                                         VerticalAlignment="Center" Margin="0,0,12,0" />
                                <Ellipse Grid.Column="0" Width="10" Height="10" Fill="{StaticResource LineBrush}" IsVisible="{Binding !Online}"
                                         VerticalAlignment="Center" Margin="0,0,12,0" />
                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{Binding Name}" Classes="title" />
                                        <TextBlock Text="{Binding VersionText}" Classes="muted" FontSize="12" VerticalAlignment="Center"
                                                   IsVisible="{Binding !IsVersionMismatch}" />
                                        <Border Classes="chip" Background="{StaticResource WarnBrush}" IsVisible="{Binding IsVersionMismatch}"
                                                ToolTip.Tip="Tento PC má jinou verzi GameShare než tenhle.">
                                            <TextBlock Text="{Binding VersionText}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding DetailText}" Classes="muted" FontSize="12" />
                                    <TextBlock Text="{Binding ActivityText}" FontSize="12" IsVisible="{Binding ActivityText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    <ProgressBar Value="{Binding Percent}" Maximum="100" IsVisible="{Binding IsBusy}" MaxWidth="360" HorizontalAlignment="Left" Margin="0,2" />
                                    <TextBlock Text="{Binding SpaceText}" Classes="muted" FontSize="12" IsVisible="{Binding !IsLowOnSpace}" />
                                    <TextBlock Text="{Binding SpaceText}" Foreground="{StaticResource WarnBrush}" FontSize="12" IsVisible="{Binding IsLowOnSpace}" />
                                    <TextBlock Text="{Binding Problem}" Foreground="{StaticResource DangerBrush}" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding HasProblem}" />
                                </StackPanel>
                                <Button Grid.Column="2" Classes="primary" Content="Spravovat" Command="{Binding ManageCommand}"
                                        IsEnabled="{Binding Online}" IsVisible="{Binding !ShowWake}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Content="Zapnout" Command="{Binding WakeCommand}" IsVisible="{Binding ShowWake}"
                                        ToolTip.Tip="Pošle do sítě Wake-on-LAN. Funguje, jen když ho má PC zapnuté v BIOSu a u síťové karty."
                                        Margin="8,0,0,0" VerticalAlignment="Center" />
                                <Button Grid.Column="3" Content="Odebrat" Command="{Binding RemoveCommand}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="muted" FontSize="12" IsVisible="{Binding !HasTargets}" Text="Zatím žádné." />

            <TextBlock Text="Spárovat s dalším PC" FontWeight="SemiBold" Margin="0,10,0,0" />
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                       Text="Na tom PC zapni dole vzdálenou správu a klikni na Spárovat nové PC. Kód, který ukáže, opiš sem." />
            <Grid ColumnDefinitions="220,*,Auto" IsVisible="{Binding HasChoices}">
                <ComboBox Grid.Column="0" ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedPeer}"
                          PlaceholderText="Vyber PC" HorizontalAlignment="Stretch" Margin="0,0,8,0" />
                <TextBox Grid.Column="1" Text="{Binding CodeInput}" PlaceholderText="Kód, například K7QF-M2XP-9HTD"
                         FontFamily="Consolas,monospace" Margin="0,0,8,0" />
                <Button Grid.Column="2" Classes="primary" Content="Spárovat" Command="{Binding PairCommand}" />
            </Grid>
            <TextBlock Classes="muted" FontSize="12" IsVisible="{Binding !HasChoices}"
                       Text="Na síti teď není žádné další PC, se kterým by šlo spárovat." />

            <!-- ==== This PC as a target ==== -->
            <TextBlock Classes="section" Text="VZDÁLENÁ SPRÁVA TOHOTO PC" Margin="0,18,0,0" />
            <ToggleSwitch IsChecked="{Binding Enabled}" IsEnabled="{Binding Allowed}"
                          OnContent="Spárovaná PC mohou tento PC spravovat" OffContent="Tento PC nikdo jiný spravovat nemůže" />
            <TextBlock Text="{Binding StateText}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap">
                <Run Text="Otisk certifikátu tohoto PC: " /><Run Text="{Binding FingerprintText}" FontFamily="Consolas,monospace" />
            </TextBlock>

            <StackPanel IsVisible="{Binding Enabled}" Spacing="6" Margin="0,6,0,0">
                <Button Content="Spárovat nové PC" Command="{Binding StartPairingCommand}" IsVisible="{Binding !HasPairing}" />

                <Border Classes="card" IsVisible="{Binding HasPairing}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Na PC, ze kterého chceš tento spravovat, opiš tento kód:" />
                        <SelectableTextBlock Text="{Binding PairingCode}" FontFamily="Consolas,monospace" FontSize="30" FontWeight="Bold"
                                             HorizontalAlignment="Center" Margin="0,6" />
                        <TextBlock Text="{Binding PairingUntilText}" Classes="muted" FontSize="12" HorizontalAlignment="Center" />
                        <Button Content="Zrušit" Command="{Binding CancelPairingCommand}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <TextBlock Text="Kdo může tento PC spravovat" FontWeight="SemiBold" Margin="0,10,0,0" />
            <ItemsControl ItemsSource="{Binding Controllers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ControllerRow">
                        <Border Classes="card" Padding="12,8">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Classes="title" />
                                    <TextBlock Text="{Binding DetailText}" Classes="muted" FontSize="12" />
                                </StackPanel>
                                <Button Grid.Column="1" Classes="danger" Content="Odebrat" Command="{Binding RemoveCommand}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="muted" FontSize="12" IsVisible="{Binding !HasControllers}" Text="Nikdo." />

            <!-- ==== Backup of the pairings ==== -->
            <TextBlock Classes="section" Text="ZÁLOHA SPÁROVÁNÍ" Margin="0,18,0,0" />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="Po přeinstalaci Windows nebo výměně disku obnov spárování ze zálohy a nemusíš znovu párovat. Záloha je zašifrovaná heslem. Kdo ji má i s heslem, může ovládat všechna spárovaná PC, takže ji drž na flashce nebo v trezoru." />
            <Grid ColumnDefinitions="*,*,Auto" Margin="0,4,0,0">
                <TextBox Grid.Column="0" Text="{Binding BackupPassword}" PasswordChar="•" PlaceholderText="Heslo zálohy (aspoň 8 znaků)" Margin="0,0,8,0" />
                <TextBox Grid.Column="1" Text="{Binding BackupPasswordAgain}" PasswordChar="•" PlaceholderText="Heslo znovu" Margin="0,0,8,0" />
                <Button Grid.Column="2" Content="Uložit zálohu…" Command="{Binding SaveBackupCommand}" />
            </Grid>
            <Button Content="Obnovit ze zálohy…" Command="{Binding PickBackupCommand}" IsVisible="{Binding !IsRestoring}" Margin="0,4,0,0" />
            <Border Classes="card" IsVisible="{Binding IsRestoring}" BorderBrush="{StaticResource WarnBrush}" BorderThickness="1">
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding RestoreFileText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap"
                               Text="Obnova nahradí identitu a spárování tohoto PC tím ze zálohy a agent se restartuje. Dělej to jen na tom samém PC po přeinstalaci; dokud původní PC běží v síti, obnova se odmítne." />
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBox Grid.Column="0" Text="{Binding RestorePassword}" PasswordChar="•" PlaceholderText="Heslo zálohy" Margin="0,0,8,0" />
                        <Button Grid.Column="1" Classes="primary" Content="Obnovit" Command="{Binding RestoreCommand}" Margin="0,0,8,0" />
                        <Button Grid.Column="2" Content="Zrušit" Command="{Binding CancelRestoreCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel IsVisible="{Binding HasRecent}" Spacing="4" Margin="0,10,0,0">
                <TextBlock Text="Co spárovaná PC udělala na tomto PC" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding Recent}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding}" FontSize="12" Margin="0,2" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
