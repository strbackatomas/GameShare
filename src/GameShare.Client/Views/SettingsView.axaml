<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameShare.Client.ViewModels"
             x:Class="GameShare.Client.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <!-- The Fluent expander is black and grey; this one looks like the cards around it. -->
    <UserControl.Styles>
        <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        </Style>
        <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:pointerover /template/ Border#ToggleButtonBackground">
            <Setter Property="Background" Value="{StaticResource LineBrush}" />
        </Style>
    </UserControl.Styles>
    <UserControl.Resources>
        <StaticResource x:Key="ExpanderContentBackground" ResourceKey="PanelBrush" />
        <StaticResource x:Key="ExpanderContentBorderBrush" ResourceKey="LineBrush" />
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel Margin="24,8,24,24" MaxWidth="760" HorizontalAlignment="Left" Spacing="6">

            <TextBlock Classes="section" Text="SLOŽKY S HRAMI" />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="Hry se hledají v těchto složkách a instalují se do první z nich. Každá hra je jedna podsložka, například BeamNG." />

            <ItemsControl ItemsSource="{Binding Roots}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RootItem">
                        <Border Classes="card" Padding="12,8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding Path}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="1" Classes="danger" Content="Odebrat" Command="{Binding RemoveCommand}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2,0,0">
                <TextBox Grid.Column="0" Text="{Binding NewRoot}" PlaceholderText="Přidat složku, například E:\Games" Margin="0,0,8,0" />
                <Button Grid.Column="1" Content="Procházet…" Command="{Binding BrowseCommand}" Margin="0,0,8,0" />
                <Button Grid.Column="2" Content="Přidat" Command="{Binding AddRootCommand}" />
            </Grid>

            <TextBlock Classes="section" Text="SDÍLENÍ" />
            <ToggleSwitch IsChecked="{Binding SeedingEnabled}" OnContent="Sdílet hry ostatním PC v síti" OffContent="Nesdílet hry ostatním PC v síti" />
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                       Text="Hry se posílají jen po místní síti, nikdy do internetu." />

            <StackPanel IsVisible="{Binding HasIgnoredAdapters}" Spacing="6">
                <TextBlock Classes="section" Text="IGNOROVANÉ SÍŤOVÉ ADAPTÉRY" />
                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                           Text="Tyhle adaptéry vypadají jako virtuální (VirtualBox, Hyper-V, …) a GameShare je proto v hledání ostatních PC přeskakuje – jejich adresa se totiž plete se skutečnou síťovkou a stahování kvůli tomu vypadává. Klidně je zase zapni, pokud přes ně chceš opravdu sdílet." />

                <ItemsControl ItemsSource="{Binding IgnoredAdapters}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AdapterItem">
                            <Border Classes="card" Padding="12,8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Description}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Zapnout" Command="{Binding UnignoreCommand}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <TextBlock Classes="section" Text="OMEZENÍ RYCHLOSTI" />
            <Grid ColumnDefinitions="Auto,140,Auto,140" RowDefinitions="Auto" HorizontalAlignment="Left">
                <TextBlock Grid.Column="0" Text="Odesílání (MB/s)" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBox Grid.Column="1" Text="{Binding MaxUploadText}" PlaceholderText="bez omezení" />
                <TextBlock Grid.Column="2" Text="Stahování (MB/s)" VerticalAlignment="Center" Margin="24,0,10,0" />
                <TextBox Grid.Column="3" Text="{Binding MaxDownloadText}" PlaceholderText="bez omezení" />
            </Grid>

            <!-- Knobs of the transfer engine for chasing a slow transfer. Collapsed, they are not for everyday use. -->
            <Expander Margin="0,14,0,0" HorizontalAlignment="Stretch" IsExpanded="{Binding IsTuningOpen}">
                <Expander.Header>
                    <TextBlock Classes="section" Text="POKROČILÉ – LADĚNÍ PŘENOSŮ" Margin="0" />
                </Expander.Header>
                <StackPanel Spacing="8">
                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                               Text="Pro hledání příčiny pomalého přenosu. Prázdné pole znamená výchozí hodnotu. Po uložení platí hned, i pro běžící přenosy. Co se použilo, je v Protokolu (Transfer tuning)." />
                    <Grid ColumnDefinitions="210,110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,4,0,0">
                        <Grid.Styles>
                            <Style Selector="TextBlock.hint">
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="Margin" Value="12,0,0,0" />
                                <Setter Property="TextWrapping" Value="Wrap" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                            <Style Selector="TextBox">
                                <Setter Property="Margin" Value="0,3" />
                            </Style>
                        </Grid.Styles>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Otevřené soubory" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding OpenFilesText}" PlaceholderText="výchozí 500" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Classes="muted hint" Text="Kolik souborů her smí být otevřeno naráz. Hry z tisíců malých souborů potřebují hodně." />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Načítání dopředu (KiB)" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SendBufferText}" PlaceholderText="výchozí 500" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Classes="muted hint" Text="Kolik dat má odesílající PC pro každé spojení připravených z disku. Zvýšení může pomoct, když jedno PC neposílá víc než kolem 20 MB/s." />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Fronta na zápis (KiB)" VerticalAlignment="Center" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DiskQueueText}" PlaceholderText="výchozí 1024" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Classes="muted hint" Text="Kolik přijatých dat smí čekat na zápis na disk. Když je plná, stahování přestane číst ze sítě." />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Odesílat naráz PC" VerticalAlignment="Center" />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding UploadSlotsText}" PlaceholderText="výchozí 8" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Classes="muted hint" Text="Kolika PC se posílá zároveň, ostatní se střídají. -1 znamená všem." />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Žádostí naráz" VerticalAlignment="Center" />
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding RequestQueueText}" PlaceholderText="výchozí 500" />
                        <TextBlock Grid.Row="4" Grid.Column="2" Classes="muted hint" Text="Kolik bloků (po 16 KiB) si stahování od jednoho zdroje objedná dopředu." />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Vlákna pro disk" VerticalAlignment="Center" />
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding DiskThreadsText}" PlaceholderText="výchozí 10" />
                        <TextBlock Grid.Row="5" Grid.Column="2" Classes="muted hint" Text="Kolik vláken čte a zapisuje na disk zároveň." />
                    </Grid>
                    <Button Content="Vrátit výchozí hodnoty" Command="{Binding ResetTuningCommand}" HorizontalAlignment="Left" />
                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="Vrátí pole na výchozí hodnoty. Platit začnou až po Uložit." />
                </StackPanel>
            </Expander>

            <TextBlock Classes="section" Text="OVĚŘENÉ HRY" />
            <TextBlock Text="{Binding TrustText}" Classes="muted" TextWrapping="Wrap" />
            <Button Content="Načíst seznam znovu" Command="{Binding RefreshTrustCommand}" IsVisible="{Binding TrustEnabled}" HorizontalAlignment="Left" />

            <TextBlock Classes="section" Text="O APLIKACI" />
            <TextBlock Classes="muted" TextWrapping="Wrap">
                <Run Text="Klient v" /><Run Text="{Binding App.ClientVersion}" />
                <Run Text="   ·   Agent v" /><Run Text="{Binding App.AgentVersion}" />
            </TextBlock>
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource WarnBrush}"
                       IsVisible="{Binding App.HasVersionMismatch}"
                       Text="Klient a agent mají jinou verzi. Restartuj GameShare, a když to nepomůže, nainstaluj oba znovu ve stejné verzi." />

            <TextBlock Text="{Binding App.UpdateText}" Classes="muted" TextWrapping="Wrap" Margin="0,8,0,0" />
            <TextBlock Text="{Binding App.UpdateMessage}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}"
                       IsVisible="{Binding App.UpdateMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Zkontrolovat aktualizace" Command="{Binding App.CheckUpdateCommand}" />
                <Button Classes="primary" Content="Aktualizovat" Command="{Binding App.ApplyUpdateCommand}" IsVisible="{Binding App.CanApplyUpdate}" />
            </StackPanel>
            <Border Classes="card" Padding="14,10" IsVisible="{Binding App.HasUpdateNotes}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Co je nového" FontWeight="SemiBold" />
                    <SelectableTextBlock Text="{Binding App.UpdateNotes}" TextWrapping="Wrap" FontSize="12" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,22,0,0">
                <Button Classes="primary" Content="Uložit" Command="{Binding SaveCommand}" MinWidth="110" HorizontalContentAlignment="Center" />
                <TextBlock Text="{Binding Message}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
