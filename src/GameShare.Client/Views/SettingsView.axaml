<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameShare.Client.ViewModels"
             x:Class="GameShare.Client.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer>
        <StackPanel Margin="24,8,24,24" MaxWidth="760" HorizontalAlignment="Left" Spacing="6">

            <TextBlock Classes="section" Text="SLOŽKY S HRAMI" />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="Hry se hledají v těchto složkách a instalují se do první z nich. Každá hra je jedna podsložka, například BeamNG." />

            <ItemsControl ItemsSource="{Binding Roots}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RootItem">
                        <Border Classes="card" Padding="12,8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding Path}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="1" Classes="danger" Content="Odebrat" Command="{Binding RemoveCommand}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                <TextBox Grid.Column="0" Text="{Binding NewRoot}" PlaceholderText="Přidat složku, například E:\Games" Margin="0,0,8,0" />
                <Button Grid.Column="1" Content="Přidat" Command="{Binding AddRootCommand}" />
            </Grid>

            <TextBlock Classes="section" Text="SDÍLENÍ" />
            <ToggleSwitch IsChecked="{Binding SeedingEnabled}" OnContent="Sdílet hry ostatním PC v síti" OffContent="Nesdílet hry ostatním PC v síti" />
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                       Text="Hry se posílají jen po místní síti, nikdy do internetu." />

            <TextBlock Classes="section" Text="OMEZENÍ RYCHLOSTI" />
            <Grid ColumnDefinitions="Auto,140,Auto,140" RowDefinitions="Auto" HorizontalAlignment="Left">
                <TextBlock Grid.Column="0" Text="Odesílání (MB/s)" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBox Grid.Column="1" Text="{Binding MaxUploadText}" PlaceholderText="bez omezení" />
                <TextBlock Grid.Column="2" Text="Stahování (MB/s)" VerticalAlignment="Center" Margin="24,0,10,0" />
                <TextBox Grid.Column="3" Text="{Binding MaxDownloadText}" PlaceholderText="bez omezení" />
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,22,0,0">
                <Button Classes="primary" Content="Uložit" Command="{Binding SaveCommand}" MinWidth="110" HorizontalContentAlignment="Center" />
                <TextBlock Text="{Binding Message}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
