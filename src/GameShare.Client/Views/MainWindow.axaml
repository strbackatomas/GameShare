<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GameShare.Client.ViewModels"
        xmlns:views="using:GameShare.Client.Views"
        x:Class="GameShare.Client.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="GameShare"
        Width="1040" Height="700" MinWidth="760" MinHeight="480"
        Background="{StaticResource BgBrush}">

    <Window.DataTemplates>
        <DataTemplate DataType="vm:LibraryViewModel"><views:LibraryView /></DataTemplate>
        <DataTemplate DataType="vm:DownloadsViewModel"><views:DownloadsView /></DataTemplate>
        <DataTemplate DataType="vm:NetworkViewModel"><views:NetworkView /></DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel"><views:SettingsView /></DataTemplate>
    </Window.DataTemplates>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Shown only while the agent cannot be reached. Everything below keeps its last state. -->
        <Border Grid.Row="0" IsVisible="{Binding !App.IsConnected}" Background="{StaticResource WarnBrush}" Padding="20,8">
            <TextBlock Text="{Binding App.ConnectionText}" Foreground="#101216" FontWeight="SemiBold" TextWrapping="Wrap" />
        </Border>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="24,12">
                <TextBlock Grid.Column="0" Text="GameShare" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,28,0" />

                <ListBox Grid.Column="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                         Background="Transparent" BorderThickness="0" VerticalAlignment="Center">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavItem">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="6,2">
                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Border Classes="chip" Background="{StaticResource AccentBrush}" IsVisible="{Binding HasBadge}">
                                    <TextBlock Text="{Binding Badge}" />
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse Width="9" Height="9" Fill="{StaticResource SuccessBrush}" IsVisible="{Binding App.IsConnected}" VerticalAlignment="Center" />
                    <Ellipse Width="9" Height="9" Fill="{StaticResource WarnBrush}" IsVisible="{Binding !App.IsConnected}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding App.MachineName}" Classes="muted" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <ContentControl Grid.Row="2" Content="{Binding SelectedItem.Page}" />
    </Grid>
</Window>
