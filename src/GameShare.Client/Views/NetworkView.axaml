<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameShare.Client.ViewModels"
             x:Class="GameShare.Client.Views.NetworkView"
             x:DataType="vm:NetworkViewModel">

    <UserControl.DataTemplates>
        <!-- One line of the network check: a coloured dot, what, and its state. -->
        <DataTemplate DataType="vm:CheckRow">
            <Grid ColumnDefinitions="22,Auto,*" Margin="0,3">
                <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center" Fill="{StaticResource SuccessBrush}" IsVisible="{Binding IsOk}" />
                <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center" Fill="{StaticResource WarnBrush}" IsVisible="{Binding IsWarn}" />
                <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center" Fill="{StaticResource DangerBrush}" IsVisible="{Binding IsBad}" />
                <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center" Fill="{StaticResource LineBrush}" IsVisible="{Binding IsOff}" />
                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" MinWidth="260" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding Detail}" Classes="muted" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,0,0" />
            </Grid>
        </DataTemplate>
    </UserControl.DataTemplates>

    <ScrollViewer>
        <StackPanel Margin="24,20,24,24" MaxWidth="980" HorizontalAlignment="Stretch">

            <Border Classes="card" DataContext="{Binding Check}" Margin="0,0,0,16">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Kontrola sítě" Classes="title" />
                            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding !HasResult}"
                                       Text="Ověří, jestli je síť soukromá, jestli firewall pouští porty GameShare a jestli odpovídají ostatní PC." />
                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasResult}">
                                <Ellipse Width="10" Height="10" Fill="{StaticResource SuccessBrush}" IsVisible="{Binding IsOverallOk}" VerticalAlignment="Center" />
                                <Ellipse Width="10" Height="10" Fill="{StaticResource WarnBrush}" IsVisible="{Binding IsOverallWarn}" VerticalAlignment="Center" />
                                <Ellipse Width="10" Height="10" Fill="{StaticResource DangerBrush}" IsVisible="{Binding IsOverallBad}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Zkontrolovat" Command="{Binding CheckCommand}" VerticalAlignment="Center" />
                    </Grid>
                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsChecking}" />
                    <TextBlock Text="{Binding Message}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                               IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <ItemsControl ItemsSource="{Binding Advice}" IsVisible="{Binding HasAdvice}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{Binding StringFormat='→ {0}'}" TextWrapping="Wrap" Foreground="{StaticResource WarnBrush}" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel IsVisible="{Binding HasResult}" Spacing="2">
                        <TextBlock Classes="section" Text="SÍTĚ" Margin="0,6,0,2" />
                        <ItemsControl ItemsSource="{Binding Networks}" />
                        <TextBlock Classes="section" Text="PORTY" Margin="0,10,0,2" />
                        <ItemsControl ItemsSource="{Binding Ports}" />
                        <StackPanel IsVisible="{Binding HasPeers}" Spacing="2">
                            <TextBlock Classes="section" Text="SPOJENÍ S OSTATNÍMI PC" Margin="0,10,0,2" />
                            <ItemsControl ItemsSource="{Binding Peers}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Classes="muted" HorizontalAlignment="Center" Margin="0,40" TextAlignment="Center" TextWrapping="Wrap"
                       IsVisible="{Binding !Peers.Count}"
                       Text="Žádné další PC s GameShare nebylo nalezeno. Zkontroluj, že na nich agent běží a že jsou ve stejné síti." />

            <ItemsControl ItemsSource="{Binding Peers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PeerViewModel">
                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <Button Classes="row" Command="{Binding ToggleExpandCommand}">
                                    <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto">
                                        <Ellipse Grid.Column="0" Width="10" Height="10" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Chevron}" Classes="muted" VerticalAlignment="Center" Width="16" />
                                        <StackPanel Grid.Column="3" Spacing="2" Margin="6,0,0,0">
                                            <TextBlock Text="{Binding Name}" Classes="title" />
                                            <TextBlock Text="{Binding Address}" Classes="muted" FontSize="12" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="4" Text="{Binding VersionText}" Classes="muted" FontSize="12" VerticalAlignment="Center"
                                                   Margin="0,0,10,0" IsVisible="{Binding ShowVersionPlain}" />
                                        <Border Grid.Column="4" Classes="chip" Background="{StaticResource WarnBrush}" VerticalAlignment="Center"
                                                Margin="0,0,10,0" IsVisible="{Binding IsVersionMismatch}"
                                                ToolTip.Tip="Tento PC má jinou verzi GameShare, může fungovat trochu jinak.">
                                            <TextBlock Text="{Binding VersionText}" />
                                        </Border>
                                        <TextBlock Grid.Column="5" Text="{Binding GamesText}" Classes="muted" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>

                                <StackPanel IsVisible="{Binding IsExpanded}" Spacing="6" Margin="30,0,0,0">
                                    <TextBlock Text="Načítám…" Classes="muted" FontSize="12" IsVisible="{Binding IsLoadingGames}" />
                                    <TextBlock Text="{Binding GamesError}" Foreground="{StaticResource DangerBrush}" FontSize="12" TextWrapping="Wrap"
                                               IsVisible="{Binding HasGamesError}" />
                                    <TextBlock Text="Tento PC teď nic nenabízí." Classes="muted" FontSize="12" IsVisible="{Binding ShowNoGames}" />

                                    <ItemsControl ItemsSource="{Binding Games}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:PeerGameRow">
                                                <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13" />
                                                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" Classes="muted" FontSize="12" Margin="12,0,0,0" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
