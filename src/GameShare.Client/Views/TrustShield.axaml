<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GameShare.Client.Views.TrustShield"
             Width="20" Height="22" VerticalAlignment="Center">
    <!-- What the administrator's signed list says about a game, as a shield: green with a tick, orange with "!", red with a cross. -->
    <Viewbox Stretch="Uniform">
        <Canvas Width="24" Height="24">
            <Path x:Name="Shield" Data="M12,1.5 L20.5,4.8 V11 C20.5,16.4 16.9,20.9 12,22.5 C7.1,20.9 3.5,16.4 3.5,11 V4.8 Z" />
            <Path x:Name="Mark" Stroke="White" StrokeThickness="2.4" StrokeLineCap="Round" StrokeJoin="Round" />
        </Canvas>
    </Viewbox>
</UserControl>
