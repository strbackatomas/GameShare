<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GameShare.Client.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#12151B" />
        <SolidColorBrush x:Key="PanelBrush" Color="#1A1E26" />
        <SolidColorBrush x:Key="CardBrush" Color="#212632" />
        <SolidColorBrush x:Key="LineBrush" Color="#2E3542" />
        <SolidColorBrush x:Key="TextBrush" Color="#E7EAF0" />
        <SolidColorBrush x:Key="MutedBrush" Color="#98A2B3" />
        <SolidColorBrush x:Key="AccentBrush" Color="#4C8DFF" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#2FAE6B" />
        <SolidColorBrush x:Key="WarnBrush" Color="#D9922B" />
        <SolidColorBrush x:Key="DangerBrush" Color="#D2504A" />
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- Text -->
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="1.5" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>

        <!-- Surfaces -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style Selector="Border.chip">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.chip > TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <!-- Buttons -->
        <Style Selector="Button">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#6AA0FF" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        </Style>

        <Style Selector="ProgressBar">
            <Setter Property="Height" Value="8" />
            <Setter Property="MinHeight" Value="8" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Background" Value="{StaticResource LineBrush}" />
        </Style>
    </Application.Styles>
</Application>
